```

## Pisanie Testów

### Podstawowy Test E2E

```typescript
import { test, expect } from '@playwright/test';

test('homepage loads correctly', async ({ page }) => {
  // Przejdź na stronę główną
  await page.goto('/');

  // Sprawdź tytuł strony
  await expect(page).toHaveTitle(/HouseFlow/);

  // Sprawdź obecność kluczowych elementów
  await expect(page.locator('text=Welcome to HouseFlow')).toBeVisible();
});
```

### Test z Autentyfikacją

```typescript
import { test, expect } from '@playwright/test';

test.describe('Authentication', () => {
  test('user can login successfully', async ({ page }) => {
    // Przejdź na stronę logowania
    await page.goto('/login');

    // Wypełnij formularz logowania
    await page.fill('[name="email"]', 'test@example.com');
    await page.fill('[name="password"]', 'password123');

    // Kliknij przycisk logowania
    await page.click('button[type="submit"]');

    // Sprawdź przekierowanie na dashboard
    await expect(page).toHaveURL('/');

    // Sprawdź obecność elementu świadczącego o zalogowaniu
    await expect(page.locator('text=Welcome back')).toBeVisible();
  });

  test('login fails with invalid credentials', async ({ page }) => {
    await page.goto('/login');

    await page.fill('[name="email"]', 'invalid@example.com');
    await page.fill('[name="password"]', 'wrongpassword');

    await page.click('button[type="submit"]');

    // Sprawdź komunikat błędu
    await expect(page.locator('text=Invalid credentials')).toBeVisible();
  });
});
```

### Testy Mobilne

```typescript
import { test, expect, devices } from '@playwright/test';

test.use({ ...devices['iPhone 12'] });

test('mobile navigation works', async ({ page }) => {
  await page.goto('/');

  // Sprawdź czy menu mobilne jest widoczne
  const menuButton = page.locator('[data-testid="mobile-menu"]');
  await expect(menuButton).toBeVisible();

  // Otwórz menu
  await menuButton.click();

  // Sprawdź pozycje menu
  await expect(page.locator('text=Dashboard')).toBeVisible();
  await expect(page.locator('text=Expenses')).toBeVisible();
  await expect(page.locator('text=Goals')).toBeVisible();
});
```

### Testy z API Mocking

```typescript
import { test, expect } from '@playwright/test';

test('dashboard shows expense data', async ({ page }) => {
  // Mock API response dla wydatków
  await page.route('/api/expenses', async (route) => {
    await route.fulfill({
      status: 200,
      contentType: 'application/json',
      body: JSON.stringify([
        { id: 1, amount: 50, category: 'Food', description: 'Lunch' },
        { id: 2, amount: 30, category: 'Transport', description: 'Bus ticket' },
      ]),
    });
  });

  await page.goto('/');

  // Sprawdź czy dane są wyświetlane
  await expect(page.locator('text=Lunch')).toBeVisible();
  await expect(page.locator('text=$50.00')).toBeVisible();
  await expect(page.locator('text=Bus ticket')).toBeVisible();
  await expect(page.locator('text=$30.00')).toBeVisible();
});
```

### Page Object Model

```typescript
// e2e/utils/pages/LoginPage.ts
export class LoginPage {
  constructor(private page: Page) {}

  async goto() {
    await this.page.goto('/login');
  }

  async login(email: string, password: string) {
    await this.page.fill('[name="email"]', email);
    await this.page.fill('[name="password"]', password);
    await this.page.click('button[type="submit"]');
  }

  async getErrorMessage() {
    return this.page.locator('.error-message').textContent();
  }
}

// Użycie w teście
import { LoginPage } from '../utils/pages/LoginPage';

test('login with page object', async ({ page }) => {
  const loginPage = new LoginPage(page);

  await loginPage.goto();
  await loginPage.login('user@example.com', 'password');

  await expect(page).toHaveURL('/');
});
```

## Fixtures i Helpery

### fixtures.ts

```typescript
import { test as base } from '@playwright/test';
import { LoginPage } from './utils/pages/LoginPage';

type TestFixtures = {
  loginPage: LoginPage;
  authenticatedPage: Page;
};

export const test = base.extend<TestFixtures>({
  loginPage: async ({ page }, use) => {
    const loginPage = new LoginPage(page);
    await use(loginPage);
  },

  authenticatedPage: async ({ page }, use) => {
    // Automatyczne logowanie przed testem
    const loginPage = new LoginPage(page);
    await loginPage.goto();
    await loginPage.login('test@example.com', 'password123');
    await use(page);
  },
});

export { expect } from '@playwright/test';
```

