---
// Szczegóły celu oszczędnościowego - strona z wpłatami
import { GoalDetailPage } from "../../components/goals/GoalDetailPage";
import Navbar from "../../components/Navbar";
import Layout from "../../layouts/Layout.astro";

// Pobierz ID celu z parametrów ścieżki
const { id } = Astro.params;

// Sprawdź czy ID zostało podane
if (!id) {
  return Astro.redirect("/goals");
}
---

<Layout title="Szczegóły celu - HouseFlow">
  <!-- Navbar -->
  <Navbar client:only="react" />

  <!-- Goal Detail Page -->
  <GoalDetailPage goalId={id} client:only="react" />
</Layout>
