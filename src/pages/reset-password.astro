---
import ResetPasswordForm from "../components/ResetPasswordForm";
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Resetowanie hasła - HouseFlow">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <h2
        class="mt-6 text-center text-3xl font-extrabold bg-gradient-to-r from-gray-900 via-orange-800 to-red-800 dark:from-white dark:via-orange-200 dark:to-red-200 bg-clip-text text-transparent"
      >
        Resetowanie hasła
      </h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Odzyskaj dostęp do swojego konta HouseFlow</p>
    </div>

    <div class="transform hover:scale-105 transition-all duration-300">
      <ResetPasswordForm client:only="react" />
    </div>
  </div>
</AuthLayout>
<style>
  .bg-clip-text {
    -webkit-background-clip: text;
    background-clip: text;
  }

  .text-transparent {
    -webkit-text-fill-color: transparent;
  }
</style>
